datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Usado apenas para o login da administradora do chá. Quem reserva números
// não precisa de conta — informa apenas nome e telefone na hora da reserva.
model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

enum ReservationStatus {
  PENDING
  PAID
  CANCELED
}

model Reservation {
  id          String            @id @default(cuid())
  buyerName   String
  buyerPhone  String
  status      ReservationStatus @default(PENDING)
  totalCents  Int
  createdAt   DateTime          @default(now())
  confirmedAt DateTime?
  numbers     NumberSlot[]
}

enum NumberStatus {
  AVAILABLE
  RESERVED
  PAID
}

model NumberSlot {
  number        Int          @id
  status        NumberStatus @default(AVAILABLE)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
}
