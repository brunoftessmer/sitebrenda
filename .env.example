# Copie este arquivo para .env e troque os valores. Nunca commite o .env.
# Use só dados de desenvolvimento aqui, nunca os de produção.

# Banco Postgres de desenvolvimento. No Neon, crie uma branch própria e use a
# conexão direta (host sem "-pooler"), porque o Prisma Migrate pode falhar na
# conexão com pooling.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require"

# Assina o cookie de sessão. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-por-um-valor-aleatorio"

# Admin criado pelo seed. Telefone só com dígitos (DDD + número).
ADMIN_NAME="Admin Dev"
ADMIN_PHONE="11999999999"
ADMIN_PASSWORD="troque-esta-senha"

# Dados usados para gerar o QR code Pix. Em desenvolvimento, use dados de teste.
PIX_KEY="chave-pix-de-teste"
PIX_MERCHANT_NAME="Teste"
PIX_MERCHANT_CITY="SAO PAULO"

# Opcional: minutos até um pedido sem "Já paguei" expirar. O padrão é 180.
# RESERVATION_HOLD_MINUTES=180
